---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import '@fontsource/onest/400.css'
import "../styles/global.css";

const { lang = "en" } = Astro.props;
const isSpanish = lang === "es";
---

<!doctype html>
<html lang={lang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Fabrizzio Castro | {isSpanish ? "Portafolio" : "Portfolio"}</title>
	</head>
	<body class="relative text-black dark:text-white">
		<Header {lang} />
		<slot />
		<Footer {lang} />
	</body>
</html>

<style is:global>
	:root{
		color-scheme: light dark;
		--portfolio-background: #f8f8fe;
	}

	:root.dark {
		--portfolio-background: #0c1020;
	}

	html{
		font-family: "Onest", system-ui, sans-serif;
	}
	body {
		background-color: var(--portfolio-background);
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 100vh;
	}
</style>
