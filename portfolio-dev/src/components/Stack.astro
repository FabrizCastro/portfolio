---
import { getSkillGroups } from '../skills';

const groups = getSkillGroups(Astro.props.lang === 'es');
---

<dl class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
  {groups.map(group => (
    <div>
      <dt class="text-lg font-semibold">{group.category}</dt>
      <dd class="mt-3">
        <ul class="flex flex-wrap gap-x-4 gap-y-3">
          {group.tools.map(tool => (
            <li class="inline-flex items-center gap-2 text-sm">
              <img
                src={tool.icon}
                alt=""
                width="18"
                height="18"
                loading="lazy"
                class:list={['size-[18px] shrink-0 object-contain', { 'dark:invert': tool.monochrome }]}
              />
              {tool.name}
            </li>
          ))}
        </ul>
      </dd>
    </div>
  ))}
</dl>
