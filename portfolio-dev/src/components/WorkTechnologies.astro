---
import angular from '../assets/skills/tech-angular.svg?url';
import api from '../assets/skills/api.svg?url';
import aws from '../assets/skills/tech-aws.svg?url';
import csharp from '../assets/skills/tech-csharp.svg?url';
import docker from '../assets/skills/tech-docker.svg?url';
import dotnet from '../assets/skills/tech-dotnet.svg?url';
import fastapi from '../assets/skills/tech-fastapi.svg?url';
import kafka from '../assets/skills/tech-kafka.svg?url';
import mongodb from '../assets/skills/tech-mongodb.svg?url';
import postgres from '../assets/skills/tech-postgresql.svg?url';
import python from '../assets/skills/tech-python.svg?url';
import react from '../assets/skills/tech-react.svg?url';
import server from '../assets/skills/server.svg?url';
import spring from '../assets/skills/tech-spring.svg?url';
import sqlserver from '../assets/skills/tech-sqlserver.svg?url';
import vite from '../assets/skills/tech-vite.svg?url';

interface Props {
  technologies: string[];
  lang: 'es' | 'en';
  iconsOnly?: boolean;
}

const { technologies, lang, iconsOnly = false } = Astro.props;
const icons: Record<string, string> = {
  Angular: angular,
  'Amazon EC2': server,
  'ASP.NET Core': dotnet,
  AWS: aws,
  'C#': csharp,
  Docker: docker,
  FastAPI: fastapi,
  'Apache Kafka': kafka,
  MongoDB: mongodb,
  PostgreSQL: postgres,
  Python: python,
  React: react,
  'REST API': api,
  'Spring Boot WebFlux': spring,
  'SQL Server': sqlserver,
  Vite: vite,
};
const monochrome = new Set(['Amazon EC2', 'Apache Kafka', 'REST API']);
const iconSize = iconsOnly ? 24 : 16;
---

<ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium" aria-label={lang === 'es' ? 'Tecnologías' : 'Technologies'}>
  {technologies.map(technology => (
    <li class="inline-flex items-center gap-1.5" title={iconsOnly ? technology : undefined}>
      {icons[technology] && <img
        src={icons[technology]}
        alt={iconsOnly ? technology : ''}
        width={iconSize}
        height={iconSize}
        loading={iconsOnly ? 'eager' : 'lazy'}
        class:list={['shrink-0 object-contain', iconsOnly ? 'size-6' : 'size-4', { 'dark:invert': monochrome.has(technology) }]}
      />}
      {!iconsOnly && technology}
      {iconsOnly && !icons[technology] && <span class="sr-only">{technology}</span>}
    </li>
  ))}
</ul>
