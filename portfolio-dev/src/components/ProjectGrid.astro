---
import type { ProjectEntry, ProjectLanguage } from "../projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  entries: ProjectEntry[];
  lang: ProjectLanguage;
}

const { entries, lang } = Astro.props;
const es = lang === "es";
const categories = [...new Set(entries.map(({ category }) => category))];
const formatCount = (count: number) => es
  ? `${count} ${count === 1 ? "proyecto" : "proyectos"}`
  : `${count} ${count === 1 ? "project" : "projects"}`;
---

<div data-project-grid={lang}>
  {categories.length > 1 && (
    <div class="project-filters" role="group" aria-label={es ? "Filtrar proyectos" : "Filter projects"}>
      <button type="button" data-project-filter="" aria-pressed="true">{es ? "Todos" : "All"}</button>
      {categories.map((category) => (
        <button type="button" data-project-filter={category} aria-pressed="false">{category}</button>
      ))}
    </div>
  )}
  <span class="sr-only" aria-live="polite" data-project-count>{formatCount(entries.length)}</span>
  <ul class="project-grid">
    {entries.map((entry) => (
      <li data-project-category={entry.category}>
        <ProjectCard {entry} {lang} />
      </li>
    ))}
  </ul>
  {entries.length === 0 && <p>{es ? "No hay proyectos para mostrar." : "There are no projects to show."}</p>}
</div>

<style>
  .project-filters { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 1.25rem; }
  .project-filters button { min-height: 2.75rem; padding: 0.4rem 0.9rem; border: 1px solid rgb(148 163 184 / 0.45); border-radius: 0.5rem; font-size: 0.85rem; }
  .project-filters button[aria-pressed="true"] { background: var(--c-text-1); color: var(--portfolio-background); }
  .project-filters button:active { transform: translateY(2px); }
  .project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1.25rem; }
  .project-grid > li { min-width: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-grid]").forEach((grid) => {
    const buttons = Array.from(grid.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
    const items = Array.from(grid.querySelectorAll<HTMLElement>("[data-project-category]"));
    const count = grid.querySelector<HTMLElement>("[data-project-count]");
    const es = grid.dataset.projectGrid === "es";

    buttons.forEach((button) => button.addEventListener("click", () => {
      const category = button.dataset.projectFilter;
      buttons.forEach((filter) => filter.setAttribute("aria-pressed", String(filter === button)));
      items.forEach((item) => {
        item.hidden = !!category && item.dataset.projectCategory !== category;
      });
      const visible = items.filter((item) => !item.hidden).length;
      if (count) count.textContent = es
        ? `${visible} ${visible === 1 ? "proyecto" : "proyectos"}`
        : `${visible} ${visible === 1 ? "project" : "projects"}`;
    }));
  });
</script>
