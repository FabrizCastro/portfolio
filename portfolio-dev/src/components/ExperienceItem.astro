---
interface Props {
  title: string;
  company: string;
  date?: string;
}

const { title, company, date } = Astro.props;
---

<li class="experience-row">
  <div>
    <h3 class="text-2xl font-semibold tracking-tight">{company}</h3>
    <p class="mt-1 font-medium text-sky-800 dark:text-sky-300">{title}</p>
    {date && <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{date}</p>}
  </div>
  <div class="min-w-0 space-y-4 text-slate-700 dark:text-slate-300">
    <slot />
  </div>
  <div class="min-w-0">
    <slot name="media" />
  </div>
</li>

<style>
  .experience-row {
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid rgb(148 163 184 / .28);
  }

  @media (min-width: 900px) {
    .experience-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr) minmax(0, 1.35fr);
      gap: clamp(1.3rem, 3vw, 2.6rem);
      padding-block: 2rem;
    }
  }
</style>
