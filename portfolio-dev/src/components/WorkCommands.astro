---
import { HeroTerminal } from 'astro-component-kit/sections';
import type { WorkCase } from '../work';

interface Props {
  command: WorkCase['command'];
  lang: 'es' | 'en';
}

const { command, lang } = Astro.props;
---

<HeroTerminal
  className="work-terminal"
  title={command.label[lang]}
  eyebrow=""
  subtitle=""
  primary={{ label: '', href: '' }}
  command={command.text}
  lines={[
    { type: 'cmd', text: command.text },
    { type: 'out', text: command.output },
  ]}
/>

<style is:global>
  .work-case-notes .work-terminal {
    padding: 0;
    background: none;
  }

  .work-terminal .ht__inner {
    grid-template-columns: minmax(0, 1fr);
    gap: .75rem;
  }

  .work-terminal .ht__copy { display: contents; }

  .work-terminal .ht__eyebrow,
  .work-terminal .ht__subtitle,
  .work-terminal .ht__btn,
  .work-terminal .ht__cmd,
  .work-terminal .ht__bar p,
  .work-terminal .ht__line.ht__cursor {
    display: none;
  }

  .work-terminal .ht__title {
    margin: 0;
    font-size: .8125rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: normal;
    color: inherit;
    text-wrap: wrap;
  }

  .work-case-notes .work-terminal .ht__terminal {
    grid-area: 2 / 1;
    border: 1px solid rgb(130 153 189 / .28);
    border-radius: .85rem;
    background: #111a2b;
    box-shadow: 0 20px 36px -17px rgb(14 26 51 / .55), 0 5px 14px -7px rgb(14 26 51 / .45);
  }

  .dark .work-case-notes .work-terminal .ht__terminal {
    box-shadow: 0 25px 42px -18px rgb(0 0 0 / .86), 0 7px 15px -7px rgb(0 0 0 / .62);
  }

  .work-terminal .ht__install {
    grid-area: 2 / 1;
    place-self: start end;
    z-index: 1;
    padding: 0;
    margin: 0 .25rem 0 0;
    border: 0;
    background: none;
  }

  .work-terminal .ht__copy-btn {
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    color: #c3cfe2;
  }

  .work-terminal .ht__copy-btn:hover { background: #263750; }

  .work-terminal .ht__bar {
    min-height: 2.75rem;
    padding: .65rem .8rem;
  }

  .work-case-notes .work-terminal .ht__bar span {
    width: .45rem;
    height: .45rem;
    background: #667995;
  }

  .work-terminal .ht__lines {
    min-height: 0;
    padding: .85rem 1rem 1rem;
    font-size: .75rem;
    line-height: 1.55;
  }

  .work-terminal .ht__line {
    display: block;
    overflow: visible;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .work-terminal .ht__prompt { margin-inline-end: .5em; }
  .work-terminal .ht__line--cmd { color: #e7edf7; }
  .work-terminal .ht__line--out { color: #aebcd0; }
</style>

<script>
  const es = document.documentElement.lang === 'es';

  document.querySelectorAll('.work-terminal').forEach(terminal => {
    terminal.querySelector('.ht__copy-btn')?.setAttribute('aria-label', es ? 'Copiar comando' : 'Copy command');
  });
</script>
