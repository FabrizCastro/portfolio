---
import type { WorkCase, WorkMedia } from '../work';
import WorkCommands from './WorkCommands.astro';
import WorkMediaGallery from './WorkMediaGallery.astro';
import WorkTechnologies from './WorkTechnologies.astro';

interface Props {
  project: WorkCase;
  company: string;
  lang: 'es' | 'en';
}

const { project, company, lang } = Astro.props;
const { architecture } = project;
const diagram = architecture && `${architecture.diagram}-${architecture.language ?? lang}`;
const media: WorkMedia[] = [...(project.media ?? [])];
const emphasis = project.emphasis ?? [];
const escapeRegExp = (term: string) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const description = emphasis.length
  ? project.description[lang].split(new RegExp(`\\b(${emphasis.map(escapeRegExp).join('|')})\\b`, 'g'))
  : [project.description[lang]];

if (architecture && diagram) {
  media.unshift({
    src: `${diagram}.png`,
    darkSrc: `${diagram}-dark.png`,
    title: architecture.title ?? { es: 'Arquitectura en AWS', en: 'AWS architecture' },
    htmlSrc: `${diagram}.html`,
    alt: architecture.alt,
    width: architecture.width,
    height: architecture.height,
  });
}
---

<article id={project.id} class:list={['work-case-layout scroll-mt-24', { 'has-media': media.length }]}
  aria-labelledby={`${project.id}-title`}>
  <header class="work-case-heading">
    <h3 class="portfolio-heading" id={`${project.id}-title`}>{project.title[lang]}</h3>
    <p class="work-context">{company} <span aria-hidden="true">·</span> {project.type[lang]}</p>
  </header>
  {media.length > 0 && (
    <div class="work-case-media">
      <WorkMediaGallery items={media} {lang} id={`${project.id}-media`} title={project.title[lang]} />
    </div>
  )}
  <div class="work-case-notes">
    <p class="work-description">{description.map((part, index) => index % 2 ? <strong>{part}</strong> : part)}</p>
    {project.technologies.length > 0 && <WorkTechnologies technologies={project.technologies} {lang} iconsOnly />}
    <WorkCommands command={project.command} {lang} />
  </div>
</article>

<style>
  .work-case-layout {
    display: grid;
    align-items: start;
    row-gap: clamp(1.25rem, 2.3vw, 2.25rem);
    min-width: 0;
    color: #253140;
  }

  :global(.dark) .work-case-layout {
    color: #e0e7ef;
  }

  .work-case-heading, .work-case-media, .work-case-notes { min-width: 0; }
  .work-case-heading h3 {
    margin: 0;
    color: #18263a;
    font-size: clamp(1.65rem, 2.45vw, 2.55rem);
  }

  :global(.dark) .work-case-heading h3 {
    color: #f1f5fb;
  }

  .work-context { margin-top: .85rem; color: #4e5c70; font-size: .875rem; line-height: 1.45; }
  :global(.dark) .work-context { color: #b3c1d4; }
  .work-context span { margin-inline: .25ch; }
  .work-description { max-width: 42ch; line-height: 1.65; overflow-wrap: anywhere; }
  .work-case-notes > :global(.cq-hero-terminal-cq) { margin-top: clamp(1.5rem, 4vw, 3.75rem); }

  @media (min-width: 900px) {
    .work-case-layout.has-media {
      grid-template-columns: minmax(0, 2.35fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "media heading" "media notes";
      column-gap: clamp(2rem, 4vw, 4.5rem);
      row-gap: 1.4rem;
    }

    .has-media .work-case-media { grid-area: media; }
    .has-media .work-case-heading { grid-area: heading; }
    .has-media .work-case-notes { grid-area: notes; }
  }
</style>
