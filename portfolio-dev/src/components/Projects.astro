---
import type { ProjectEntry, ProjectGroup, ProjectLanguage } from "../projects";
import { projects } from "../projects";
import ProjectGrid from "./ProjectGrid.astro";
import ProjectShowcase from "./ProjectShowcase.astro";

interface Props {
  lang?: ProjectLanguage;
}

const { lang = "en" } = Astro.props;
const es = lang === "es";
const groups: ProjectGroup[] = ["personal", "gsitel"];
const entries: ProjectEntry[] = groups.flatMap((group) => projects[group].map((project, index) => ({
  project,
  id: `${group}-project-${index}`,
  company: group === "gsitel" ? "GSITEL" : undefined,
  category: project.category === "automation"
    ? (es ? "Automatización" : "Automation")
    : (es ? "Aplicaciones" : "Applications"),
})));
const featured = entries.filter(({ project }) => project.featured);
---

{featured.length > 0 && <ProjectShowcase entries={featured} {lang} />}
<ProjectGrid {entries} {lang} />
