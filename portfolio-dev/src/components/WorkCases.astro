---
import { work } from '../work';
const lang = Astro.props.lang === 'es' ? 'es' : 'en';
const cases = work.flatMap((job) => job.cases.map((project) => ({ ...project, company: job.company })));
---

<div class="grid gap-6 md:grid-cols-2">
  {cases.map((project) => (
    <article id={project.id} class="scroll-mt-24 rounded-xl border border-slate-400/30 p-5 target:border-amber-500">
      <p class="text-sm text-slate-600 dark:text-slate-400">{project.company} · {project.type[lang]}</p>
      <h3 class="mt-2 text-xl font-semibold">{project.title[lang]}</h3>
      <p class="mt-2 text-slate-700 dark:text-slate-300">{project.description[lang]}</p>
      {project.technologies.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label={lang === 'es' ? 'Tecnologías' : 'Technologies'}>
          {project.technologies.map((technology) => <li class="rounded-md border border-slate-400/30 px-2 py-1 text-sm">{technology}</li>)}
        </ul>
      )}
      {'images' in project && project.images && (
        <div class="mt-4 grid grid-cols-3 gap-2">
          {project.images.map((image, index) => (
            <a href={image} aria-label={lang === 'es' ? `Abrir captura ${index + 1}` : `Open screenshot ${index + 1}`}>
              <img src={image} alt="" class="aspect-video w-full rounded-md object-cover object-top" loading="lazy" />
            </a>
          ))}
        </div>
      )}
    </article>
  ))}
</div>
