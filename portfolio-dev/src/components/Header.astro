---
import ThemeToggle from "./ThemeToggle.astro"

const { lang = "en" } = Astro.props;
const es = lang === "es";
const home = es ? "/es/" : "/";
const navItems = [
  { title: es ? "Experiencia" : "Experience", id: "experience" },
  { title: es ? "Casos" : "Cases", id: "work-cases" },
  { title: es ? "Proyectos" : "Projects", id: "projects" },
  { title: "Stack", id: "stack" },
  { title: es ? "Sobre mí" : "About me", id: "about-me" },
];

---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    aria-label={es ? "Navegación principal" : "Main navigation"}
    class="portfolio-nav flex flex-wrap px-1 text-xs sm:px-3 sm:text-sm font-medium rounded-full text-gray-600 dark:text-gray-200 justify-center items-center"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-blue-500 dark:hover:text-blue-500"
          data-section={link.id}
          href={`${home}#${link.id}`}
        >
          {link.title}
        </a>
      ))
    }
    <a
      class="px-2 py-2 font-semibold transition hover:text-blue-500"
      href={es ? "/" : "/es/"}
      lang={es ? "en" : "es"}
      hreflang={es ? "en" : "es"}
      aria-label={es ? "English" : "Español"}
    >{es ? "EN" : "ES"}</a>
    <a class="hidden px-2 py-2 transition hover:text-blue-500 sm:block" href="mailto:fabrizziocastro2612@gmail.com">
      {es ? "Contacto" : "Contact"}
    </a>
    <ThemeToggle {lang} />
  </nav>
</header>

<style>
  nav {
    @apply max-w-full bg-white/90 shadow-sm backdrop-blur dark:bg-gray-800/90;
  }

  a[aria-current="location"] {
    @apply text-blue-700 dark:text-blue-300;
  }
</style>
