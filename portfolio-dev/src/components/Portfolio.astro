---
import Layout from '../layouts/Layout.astro';
import SectionContainer from './SectionContainer.astro';
import Hero from './Hero.astro';
import Stack from './Stack.astro';
import Experience from './Experience.astro';
import WorkCases from './WorkCases.astro';
import Projects from './Projects.astro';
import AboutMe from './AboutMe.astro';
import TitleSection from './TitleSection.astro';
import Briefcase from './icons/Briefcase.astro';
import CodeIcon from './icons/Code.astro';
import ProfileCheck from './icons/ProfileCheck.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const es = lang === 'es';
---

<Layout {lang}>
  <main class="portfolio-screens">
    <div class="portfolio-screen portfolio-intro">
      <Hero {lang} />
    </div>
    <div class="px-4">
      <SectionContainer id="experience" class="portfolio-screen">
        <TitleSection><Briefcase class="size-8" />{es ? 'Experiencia profesional' : 'Work experience'}</TitleSection>
        <Experience {lang} />
      </SectionContainer>

      <WorkCases {lang} />

      <SectionContainer id="projects" class="portfolio-screen">
        <TitleSection><CodeIcon class="size-7" />{es ? 'Proyectos' : 'Projects'}</TitleSection>
        <Projects {lang} />
      </SectionContainer>

      <SectionContainer id="stack" class="portfolio-screen">
        <TitleSection>{es ? 'Stack y habilidades' : 'Stack & skills'}</TitleSection>
        <Stack {lang} />
      </SectionContainer>

      <SectionContainer id="about-me" class="portfolio-screen">
        <TitleSection><ProfileCheck class="size-8" />{es ? 'Sobre mí' : 'About me'}</TitleSection>
        <AboutMe {lang} />
      </SectionContainer>
    </div>
  </main>
</Layout>

<style is:global>
  .portfolio-screen {
    min-height: 100svh;
  }

  .portfolio-screen:not(.portfolio-intro) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    padding-block: clamp(5rem, 10svh, 8rem) clamp(4rem, 9svh, 7rem);
  }

  .portfolio-screen[data-outside-focus]:not(:has(:focus-visible)) {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    html:has(.portfolio-screens) { scroll-behavior: smooth; }

    .portfolio-screen {
      transition: opacity 260ms ease;
    }
  }
</style>

<script>
  const screens = Array.from(document.querySelectorAll<HTMLElement>('.portfolio-screens .portfolio-screen'));
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.portfolio-nav [data-section]');
  let activeScreen: HTMLElement | undefined;
  let frame = 0;

  function updateScreen() {
    frame = 0;
    const center = window.innerHeight / 2;
    const nextScreen = screens.find(screen => screen.getBoundingClientRect().bottom > center) ?? screens.at(-1);
    if (activeScreen === nextScreen) return;

    activeScreen = nextScreen;
    screens.forEach(screen => screen.toggleAttribute('data-outside-focus', screen !== activeScreen));
    navLinks.forEach(link => {
      if (link.dataset.section === activeScreen?.id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  function scheduleScreenUpdate() {
    if (!frame) frame = requestAnimationFrame(updateScreen);
  }

  window.addEventListener('scroll', scheduleScreenUpdate, { passive: true });
  window.addEventListener('resize', scheduleScreenUpdate);
  const layoutObserver = new ResizeObserver(scheduleScreenUpdate);
  screens.forEach(screen => layoutObserver.observe(screen));
  updateScreen();
</script>
