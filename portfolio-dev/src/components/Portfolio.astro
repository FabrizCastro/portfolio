---
import Layout from '../layouts/Layout.astro';
import SectionContainer from './SectionContainer.astro';
import Hero from './Hero.astro';
import Stack from './Stack.astro';
import PortfolioChangelog from './PortfolioChangelog.astro';
import Experience from './Experience.astro';
import WorkCases from './WorkCases.astro';
import Projects from './Projects.astro';
import AboutMe from './AboutMe.astro';
import TitleSection from './TitleSection.astro';
import Briefcase from './icons/Briefcase.astro';
import CodeIcon from './icons/Code.astro';
import ProfileCheck from './icons/ProfileCheck.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const es = lang === 'es';
---

<Layout {lang}>
  <main>
    <Hero {lang} />
    <div class="space-y-24 px-4 pt-16 md:pt-24">
      <SectionContainer id="experience">
        <TitleSection><Briefcase class="size-8" />{es ? 'Experiencia profesional' : 'Work experience'}</TitleSection>
        <Experience {lang} />
      </SectionContainer>

      <SectionContainer id="work-cases">
        <TitleSection>{es ? 'Casos de trabajo' : 'Work case studies'}</TitleSection>
        <WorkCases {lang} />
      </SectionContainer>

      <SectionContainer id="projects">
        <TitleSection><CodeIcon class="size-7" />{es ? 'Proyectos propios' : 'Personal projects'}</TitleSection>
        <Projects {lang} />
      </SectionContainer>

      <SectionContainer id="stack">
        <TitleSection>{es ? 'Stack y habilidades' : 'Stack & skills'}</TitleSection>
        <Stack {lang} />
      </SectionContainer>

      <SectionContainer id="gsitel">
        <TitleSection><CodeIcon class="size-7" />{es ? 'Proyectos de GSITEL' : 'GSITEL projects'}</TitleSection>
        <p class="mb-8 text-gray-700 dark:text-gray-300">
          {es ? 'Proyectos de GSITEL, mi empresa.' : 'Projects from GSITEL, my company.'}
        </p>
        <Projects {lang} group="gsitel" />
      </SectionContainer>

      <SectionContainer id="changelog">
        <PortfolioChangelog {lang} />
      </SectionContainer>

      <SectionContainer id="about-me">
        <TitleSection><ProfileCheck class="size-8" />{es ? 'Sobre mí' : 'About me'}</TitleSection>
        <AboutMe {lang} />
      </SectionContainer>
    </div>
  </main>
</Layout>
