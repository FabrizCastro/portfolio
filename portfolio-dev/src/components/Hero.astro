---
import { DevHero } from 'astro-component-kit/sections';
import 'astro-component-kit/tokens.css';
import { getSkillGroups } from '../skills';

const es = Astro.props.lang === 'es';
const headlines = [
  es ? 'Software\ne IA aplicada' : 'Software\nand Applied AI',
  'AI\nEngineer',
  'Product Software\nEngineer',
  'Full-Stack\nDeveloper',
  'Software\nArchitecture',
];
const groups = getSkillGroups(es).filter(group => group.previewCount > 0).map(group => ({
  category: group.category,
  skills: group.tools.slice(0, group.previewCount),
}));

const iconStyles = groups.flatMap(group => group.skills).map(tool => {
  const selector = `.portfolio-dev-hero [data-name=${JSON.stringify(tool.name)}]`;
  const icon = `${selector} { --skill-icon: url(${JSON.stringify(tool.icon)}); }`;
  return tool.monochrome ? `${icon}\n.dark ${selector} { --skill-icon-filter: invert(1); }` : icon;
}).join('\n');
---

<DevHero
  className="portfolio-dev-hero"
  titles={headlines.map(base => ({ base, ext: '', role: '' }))}
  interval={4700}
  name="Fabrizzio Castro"
  tagline={es
    ? 'Desarrollo CuadrAI, una plataforma para reservar y gestionar canchas deportivas. En mi día a día hablo con clientes, escribo requerimientos, priorizo el backlog y diseño la arquitectura del software. Me interesa crear aplicaciones con IA y usar agentes para desarrollar.'
    : 'I’m building CuadrAI, a platform for booking and managing sports courts. Day to day, I talk to clients, write requirements, prioritize the backlog, and design the software architecture. I’m interested in building AI-powered applications and using agents in my development work.'}
  status={es ? 'Disponible para nuevos proyectos' : 'Available for new projects'}
  tapeLabel={es ? 'Stack y habilidades' : 'Stack & skills'}
  background="dots"
  skills={groups.map(group => ({
    category: group.category,
    skills: group.skills.map(({ name, description }) => ({ name, description: description ?? name })),
  }))}
/>

<style is:inline set:html={iconStyles}></style>

<style is:global>
  .portfolio-dev-hero.dvhr {
    min-height: 100svh;
    position: relative;
    overflow: hidden;
    background-color: var(--portfolio-background);
  }

  .portfolio-dev-hero .dvhr__bg {
    position: absolute;
    inset: 0;
    opacity: .5;
  }

  .portfolio-dev-hero .dvhr__wrap {
    grid-template-columns: minmax(0, 1.17fr) minmax(0, .95fr) minmax(0, .88fr);
    grid-template-areas: 'intro portrait stack';
    max-width: 1280px;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .portfolio-dev-hero .dvhr__main {
    grid-area: intro;
    container-type: inline-size;
  }

  .portfolio-dev-hero .dvhr__tape {
    grid-area: stack;
  }

  /* DevHero has no portrait slot, so the decorative portrait occupies a grid area. */
  .portfolio-dev-hero .dvhr__wrap::before {
    content: '';
    grid-area: portrait;
    justify-self: center;
    width: 76%;
    max-width: 270px;
    opacity: .62;
    aspect-ratio: 4 / 5;
    background: url('../assets/foto-perfil-hero.webp') center / contain no-repeat;
    mask-image:
      linear-gradient(to bottom, black 68%, rgb(0 0 0 / .88) 77%, rgb(0 0 0 / .38) 89%, transparent 99%),
      linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    mask-composite: intersect;
  }

  .portfolio-dev-hero .dvhr__line {
    font-size: clamp(1.85rem, 12cqi, 3.85rem);
    line-height: 1;
  }

  .portfolio-dev-hero .dvhr__title { width: 100%; }
  .portfolio-dev-hero .dvhr__line--1 { min-block-size: 2em; }
  .portfolio-dev-hero [data-base] { white-space: pre-line; }
  .portfolio-dev-hero .dvhr__line--2 { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .portfolio-dev-hero [data-base]::after {
      content: '';
      display: inline-block;
      width: .055em;
      height: .76em;
      margin-inline-start: .08em;
      background: currentColor;
      animation: hero-type-caret 1.05s step-end infinite;
    }

    @keyframes hero-type-caret {
      50% { opacity: 0; }
    }
  }

  .portfolio-dev-hero .dvhr__tagline {
    max-width: 47ch;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: normal;
    text-transform: none;
    color: var(--c-text-2);
  }

  @media (max-width: 1050px) {
    .portfolio-dev-hero .dvhr__wrap {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      grid-template-areas: 'intro portrait' 'stack stack';
      max-width: 780px;
      row-gap: 2rem;
    }

    .portfolio-dev-hero .dvhr__tape {
      width: 100%;
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .portfolio-dev-hero .dvhr__wrap {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'intro' 'portrait' 'stack';
    }

    .portfolio-dev-hero .dvhr__wrap::before {
      max-width: 165px;
    }
  }

  /* DevHero renders a decorative marker in each skill button. */
  .portfolio-dev-hero .dvhr__pill-mark {
    width: 1rem;
    height: 1rem;
    flex: none;
    border: 0;
    border-radius: 0;
    opacity: 1;
    background: var(--skill-icon) center / contain no-repeat;
    filter: var(--skill-icon-filter, none);
  }

  .portfolio-dev-hero .dvhr__track {
    animation-duration: 54s;
  }
</style>
