---
import { DevHero } from 'astro-component-kit/sections';
import 'astro-component-kit/tokens.css';

const es = Astro.props.lang === 'es';
---

<DevHero
  className="portfolio-dev-hero"
  titles={[es
    ? { base: 'Ingeniería', ext: '', role: 'de software de producto' }
    : { base: 'Product', ext: '', role: 'Software Engineer' }]}
  name="Fabrizzio Castro"
  tagline={es
    ? 'Soy egresado de Ingeniería de Software de la UPC. Desarrollo aplicaciones internas, diseño arquitecturas e integro sistemas empresariales como SAP y OfficeTrack. Tengo experiencia como Product Software Engineer, soy Founder de una aplicación de gestión de espacios deportivos emergente en Perú, y trabajo como consultor de software para digitalizar negocios.'
    : 'I’m a Software Engineering graduate from UPC. I build internal applications, design software architecture, and integrate business systems such as SAP and OfficeTrack. I also automate workflows and data processing with Python.'}
  status={es ? 'Disponible para nuevos proyectos' : 'Available for new projects'}
  tapeLabel={es ? 'Stack y habilidades' : 'Stack & skills'}
  background="dots"
  skills={[
    { category: 'Frontend', skills: [{ name: 'React', description: es ? 'Desarrollo de interfaces web.' : 'Web interface development.' }, { name: 'Astro', description: es ? 'Sitios web de contenido.' : 'Content-focused websites.' }] },
    { category: 'Backend', skills: [{ name: '.NET', description: es ? 'APIs e integraciones empresariales.' : 'APIs and business integrations.' }, { name: 'Python', description: es ? 'Procesamiento de datos y automatización.' : 'Data processing and automation.' }] },
    { category: es ? 'Automatización' : 'Automation', skills: [{ name: 'n8n', description: es ? 'Flujos de trabajo e integración de servicios.' : 'Workflows and service integration.' }] },
  ]}
/>

<style is:global>
  .portfolio-dev-hero.dvhr {
    min-height: 100svh;
    position: relative;
    overflow: hidden;
    background-color: var(--portfolio-background);
  }

  .portfolio-dev-hero .dvhr__bg {
    position: absolute;
    inset: 0;
  }

  .portfolio-dev-hero .dvhr__line {
    font-size: clamp(2.1rem, 5.6vw, 4.5rem);
  }

  .portfolio-dev-hero .dvhr__tagline {
    max-width: 47ch;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: normal;
    text-transform: none;
    color: var(--c-text-2);
  }

  /* DevHero renders a decorative marker in each skill button. */
  .portfolio-dev-hero .dvhr__pill-mark {
    width: 1rem;
    height: 1rem;
    flex: none;
    border: 0;
    border-radius: 0;
    opacity: 1;
    background-color: currentColor;
    mask: var(--skill-icon) center / contain no-repeat;
  }

  .portfolio-dev-hero [data-name="React"] {
    --skill-icon: url('../assets/skills/brand-react.svg');
  }

  .portfolio-dev-hero [data-name="Astro"] {
    --skill-icon: url('../assets/skills/brand-astro.svg');
  }

  .portfolio-dev-hero [data-name=".NET"] {
    --skill-icon: url('../assets/skills/dotnet.svg');
  }

  .portfolio-dev-hero [data-name="Python"] {
    --skill-icon: url('../assets/skills/brand-python.svg');
  }

  .portfolio-dev-hero [data-name="n8n"] {
    --skill-icon: url('../assets/skills/n8n.svg');
  }
</style>
